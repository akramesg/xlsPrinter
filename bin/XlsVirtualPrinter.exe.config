<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <!-- Prefers .NET 4.x on Windows 10 / 11 / Server 2012+ (avoids legacy GDI+ crashes & enables full network share trust) -->
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
    <!-- Backward compatibility for Windows XP / Server 2008 / Win7 machines running .NET 2.0/3.5 -->
    <supportedRuntime version="v2.0.50727" />
  </startup>
</configuration>
